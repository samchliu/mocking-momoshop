{
  "name": "web-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "lhci": "npm run build && lhci autorun",
    "analyze": "ANALYZE=1 vite build",
    "audit": "npm audit --omit=dev",
    "verify": "npm run kb:validate && npm run typecheck && npm run lint && npm run format:check && npm run spec:check && npm run test",
    "spec:check": "node scripts/spec-check.mjs",
    "kb:validate": "kb validate --code-root .",
    "kb:build": "kb build",
    "kb:trace": "kb trace",
    "approve": "node scripts/approve.mjs",
    "prepare": "husky",
    "worktree": "scripts/worktree.sh"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "living-kb": "github:samchliu/living-kb#v0.3.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,jsx}": [
      "prettier --write",
      "oxlint --deny-warnings"
    ],
    "*.{json,md,css,yaml,yml,html}": [
      "prettier --write"
    ]
  }
}
